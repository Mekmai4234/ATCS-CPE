# Process environment > 03/.env > root .env for ingestion. No real keys here.
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
METADATA_TIMEOUT_SECONDS=5
# auto uses Data API when a key is configured, otherwise public oEmbed.
# Other choices: oembed, youtube_api, none.
METADATA_PROVIDER=auto
YOUTUBE_API_KEY=
ENABLE_TRANSCRIPTION_FALLBACK=false

# The 03 factory's RAG precedence: process > 03/.env > 04/.env > root .env.
# Override the old shared root OpenAI embedding proposal explicitly.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TOKENIZER=utf8-byte-budget-v1
GEMINI_API_KEY=
CHROMA_PERSIST_DIR=./runtime/ingestion-live/chroma

# Backend DATABASE_URL/ADAPTER_* must be set as described in README.md.
# Backend Settings does not load this module's .env.

# Authentication/session settings belong to 02; this file does not configure them.
# Native import_max_urls is enforced by 02. No MEMBER_* quota settings are provided:
# durable per-account pending/running limits and fair claims remain upstream work.

# Opt-in LOCAL preparation only. No image API/upload route is enabled by this flag.
# 02 must authorize/stage uploads and agree its new evidence contract before wiring.
MEDIA_ENABLED=false
MEDIA_UPLOAD_ROOT=./runtime/uploads
MEDIA_WORK_ROOT=./runtime/media03
MEDIA_FFMPEG=ffmpeg
MEDIA_FFPROBE=ffprobe
MEDIA_TESSERACT=tesseract
# Set to the trusted engine data directory containing tha.traineddata + eng.traineddata.
# Missing engine/models keeps images and reports OCR unavailable; never calls cloud OCR.
# MEDIA_TESSDATA_DIR=/server/tessdata
MEDIA_OCR_LANGUAGES=tha+eng
MEDIA_MAX_INPUT_BYTES=268435456
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_FRAMES=12
MEDIA_SAMPLE_INTERVAL_SECONDS=60
MEDIA_MAX_PIXELS=8294400
MEDIA_MAX_FRAME_BYTES=16777216
MEDIA_TOOL_TIMEOUT_SECONDS=30
MEDIA_TOTAL_TIMEOUT_SECONDS=300
MEDIA_MEMORY_MB=1024
MEDIA_CPU_SECONDS=30
