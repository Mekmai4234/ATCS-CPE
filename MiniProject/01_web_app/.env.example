# Public values only. Never put provider credentials in this folder.
# Uses the same public API URL name as MiniProject/.env.example.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Explicit opt-in. false stays at login until module-02 auth is integrated.
VITE_DEMO_MODE=false
# Public Web Client ID only. Does not enable login without a verified SessionPort adapter.
VITE_GOOGLE_CLIENT_ID=
