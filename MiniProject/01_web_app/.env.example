# Public values only. Never put provider credentials in this folder.
# Uses the same public API URL name as MiniProject/.env.example.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Default: real HttpSessionPort. Requires the auth-enabled module-02 backend.
VITE_DEMO_MODE=false
# Default relative /api; Vite dev proxies to NEXT_PUBLIC_API_BASE_URL.
# Production needs an equivalent reverse proxy. false requires verified cookie/CORS behavior.
VITE_API_SAME_ORIGIN=true
# Legacy/test adapter fallback only; real login gets client_id from /api/auth/challenge.
VITE_GOOGLE_CLIENT_ID=
