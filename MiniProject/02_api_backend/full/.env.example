# Only the explicitly selected file is read. Process environment has higher priority.
# Root and module-local .env files are NOT merged by the full launcher.
APP_ENV=development
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
SESSION_TTL_SECONDS=86400
# Local HTTP only. Production requires true with HTTPS origins.
SESSION_COOKIE_SECURE=false
AUTH_TRUSTED_ORIGINS=["http://localhost:3000"]
ADAPTER_MODE=custom
ADAPTER_FACTORY=youtube_answers.team:create_adapters
BACKEND_INTEGRATION_PROFILE=live
DATABASE_URL=sqlite:///./runtime/backend-full-live/app.db
CHROMA_PERSIST_DIR=./runtime/backend-full-live/chroma
GEMINI_API_KEY=
# Empty/expired policy blocks outbound Gemini. See FREE_TIER_MEDIA.md for attestation.
GEMINI_FREE_POLICY_FILE=
GEMINI_MAX_CONCURRENT=1
GEMINI_USER_CONCURRENT=1
MEDIA_ASSET_DIR=./runtime/media-assets
MEDIA_MAX_FRAMES=12
MEDIA_MAX_FRAME_BYTES=2000000
LLM_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TOKENIZER=utf8-byte-budget-v1
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
METADATA_PROVIDER=auto
METADATA_TIMEOUT_SECONDS=5
YOUTUBE_API_KEY=
ENABLE_TRANSCRIPTION_FALLBACK=false
ENABLE_STREAMING=false
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
