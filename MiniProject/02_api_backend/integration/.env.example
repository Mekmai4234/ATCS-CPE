# Optional 02-owned overrides. Never commit .env or a real key.
# Process environment > this file > MiniProject/.env > defaults.
APP_ENV=development
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
# Set true for HTTPS deployment; development HTTP only may use false.
SESSION_COOKIE_SECURE=false
ADAPTER_MODE=custom
ADAPTER_FACTORY=youtube_backend.team:create_adapters
# offline = real 04/06 mechanics with labelled model/embedding doubles; no provider calls.
# live = explicit Gemini clients, requires your server-side key; 03/05 remain unavailable.
BACKEND_INTEGRATION_PROFILE=offline
DATABASE_URL=sqlite:///./runtime/backend-integration-offline/app.db
CHROMA_PERSIST_DIR=./runtime/backend-integration-offline/chroma
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
# 04 interprets these as conservative UTF-8 byte budgets, not billed model tokens.
EMBEDDING_TOKENIZER=utf8-byte-budget-v1
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_FINALIZE_RESERVE_SECONDS=10
AGENT_READ_PAGE_SIZE=30
LLM_TIMEOUT_SECONDS=60
ENABLE_STREAMING=false
