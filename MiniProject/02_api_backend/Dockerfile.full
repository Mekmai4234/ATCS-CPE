# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff AS uv
FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89 AS build
COPY --from=uv /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MINIPROJECT_ROOT=/app
WORKDIR /app
COPY 02_api_backend/pyproject.toml ./02_api_backend/
COPY 02_api_backend/full/pyproject.toml 02_api_backend/full/uv.lock ./02_api_backend/full/
COPY 03_video_ingestion/pyproject.toml ./03_video_ingestion/
COPY 04_rag_knowledge/pyproject.toml ./04_rag_knowledge/
COPY 05_ai_answers_analysis/pyproject.toml ./05_ai_answers_analysis/
COPY 06_research_learning_agent/pyproject.toml ./06_research_learning_agent/
RUN --mount=type=cache,target=/root/.cache/uv uv sync --project 02_api_backend/full --locked --no-dev --no-install-local
COPY 02_api_backend/src/ ./02_api_backend/src/
COPY 03_video_ingestion/src/ ./03_video_ingestion/src/
COPY 04_rag_knowledge/src/ ./04_rag_knowledge/src/
COPY 05_ai_answers_analysis/src/ ./05_ai_answers_analysis/src/
COPY 06_research_learning_agent/src/ ./06_research_learning_agent/src/
RUN --mount=type=cache,target=/root/.cache/uv uv sync --project 02_api_backend/full --locked --no-dev --no-editable

FROM build AS test
RUN --mount=type=cache,target=/root/.cache/uv uv sync --project 02_api_backend/full --locked --no-editable
COPY 02_api_backend/tests/ /app/02_api_backend/tests/
COPY 02_api_backend/integration/tests/ /app/02_api_backend/integration/tests/
COPY 02_api_backend/full/tests/ /app/02_api_backend/full/tests/
RUN groupadd --gid 10001 backend && useradd --uid 10001 --gid backend --no-create-home backend
ENV PATH="/app/02_api_backend/full/.venv/bin:$PATH" APP_ENV=test RUFF_CACHE_DIR=/tmp/ruff-cache
WORKDIR /app/02_api_backend
USER 10001:10001
CMD ["pytest", "tests", "integration/tests", "full/tests", "-q", "-W", "error", "-o", "cache_dir=/tmp/pytest-cache"]

FROM python:3.11-slim-bookworm@sha256:0a310eeecf4e1f5a0743f9a6520c90c88d089c903ca5fd283f501e3a805f5f89 AS runtime
ENV PATH="/app/02_api_backend/full/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MINIPROJECT_ROOT=/app
RUN groupadd --gid 10001 backend && useradd --uid 10001 --gid backend --no-create-home backend && mkdir -p /app/runtime && chown backend:backend /app/runtime
COPY --from=build /app/02_api_backend/full/.venv /app/02_api_backend/full/.venv
WORKDIR /app
USER 10001:10001
EXPOSE 8000
CMD ["yk-full", "api"]
