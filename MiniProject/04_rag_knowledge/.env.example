# Module 04 overrides. Copy to 04_rag_knowledge/.env locally; never commit a real key.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TOKENIZER=utf8-byte-budget-v1
GEMINI_API_KEY=
CHROMA_PERSIST_DIR=./runtime/chroma
# Offline conservative byte budgets, not billable Gemini token counts.
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8
EMBEDDING_BATCH_SIZE=16
RAG_OPERATION_TIMEOUT_SECONDS=60

# 02 PR #27 owns GEMINI_FREE_POLICY_FILE and project/model approval in server settings.
# An absent key/policy permits local OCR, but no external Gemini embedding dispatch.
# The live per-HTTP embedding cap is one text; EMBEDDING_BATCH_SIZE groups local work only.
