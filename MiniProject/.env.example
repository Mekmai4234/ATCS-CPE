# Planned configuration only; application loaders do not exist yet.
# Copy to .env locally. Never commit real credentials.
# Runtime paths are relative to the MiniProject root.
APP_ENV=development
LOG_LEVEL=INFO

# 01_web_app and backend CORS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# 02_api_backend
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./runtime/app.db
JOB_MAX_ATTEMPTS=3

# 03_video_ingestion
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
ENABLE_TRANSCRIPTION_FALLBACK=false
YOUTUBE_API_KEY=

# 04_rag_knowledge
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./runtime/chroma
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8

# 05_ai_answers_analysis
# Set a supported, accessible model before live generation.
LLM_MODEL=
ANSWER_MAX_OUTPUT_TOKENS=1200

# 06_research_learning_agent
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=2400
