# Planned configuration only; application loaders do not exist yet.
# Copy to .env locally. Never commit real credentials.
# Relative runtime paths resolve from the MiniProject root.
# The frontend must load its own public configuration explicitly.
APP_ENV=development
LOG_LEVEL=INFO

# 01_web_app and backend CORS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
ENABLE_STREAMING=false

# 02_api_backend
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./runtime/app.db
JOB_MAX_ATTEMPTS=3

# 03_video_ingestion
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
ENABLE_TRANSCRIPTION_FALLBACK=false
YOUTUBE_API_KEY=

# 04_rag_knowledge: existing embedding proposal, independent of Gemini generation
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=./runtime/chroma
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8

# 05_ai_answers_analysis and 06_research_learning_agent
GEMINI_API_KEY=
# Requested identifier. Google documents automatic routing of this deprecated alias
# to gemini-3.6-flash. Verify account access and returned model metadata before use.
# https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60
MAX_CONTEXT_TOKENS=24000
ANSWER_MAX_OUTPUT_TOKENS=1200

# 06_research_learning_agent
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=2400
