# Shared configuration template for modules 01-07 (all have runnable implementations).
# Copy to .env (or .env.local for the Docker stack in
# 07_testing_deployment/LOCAL_STACK.md). Never commit real credentials.
# Relative runtime paths resolve from the MiniProject root.
# The frontend reads only NEXT_PUBLIC_API_BASE_URL; every other value stays server-side.
APP_ENV=development
LOG_LEVEL=INFO

# 01_web_app and backend CORS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
ENABLE_STREAMING=false

# Authentication (02). Required by default; AUTH_ENABLED=false is a dev/test opt-out only.
AUTH_ENABLED=true
# Public OAuth client ID registered for WEB_ORIGIN (not a secret, but keep it per machine).
GOOGLE_CLIENT_ID=
AUTH_TRUSTED_ORIGINS=["http://localhost:3000"]
# true for HTTPS deployments; false only for plain-HTTP localhost.
SESSION_COOKIE_SECURE=false
CHAT_REVIEW_ENABLED=false
CHAT_REVIEW_ADMIN_IDS=[]

# 02_api_backend
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./runtime/app.db
MEDIA_ASSET_DIR=./runtime/media-assets
JOB_MAX_ATTEMPTS=3
# unavailable: explicit missing integrations; fixture: labelled offline demo/test only.
# custom + youtube_answers.team:create_adapters: the full live 03-06 system.
ADAPTER_MODE=unavailable
ADAPTER_FACTORY=
BACKEND_INTEGRATION_PROFILE=live
JOB_LEASE_SECONDS=30
JOB_TIMEOUT_SECONDS=180
JOB_RETRY_BASE_SECONDS=2
WORKER_POLL_SECONDS=0.5
IMPORT_MAX_URLS=50

# Gemini Free Tier admission (02 broker). Every Gemini call fails closed with
# free_tier_unverified unless this operator policy exists, matches GEMINI_API_KEY and
# is unexpired (at most 7 days). Renewal: 07_testing_deployment/LOCAL_STACK.md.
GEMINI_FREE_POLICY_FILE=

# 03_video_ingestion
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
ENABLE_TRANSCRIPTION_FALLBACK=false
YOUTUBE_API_KEY=

# 04_rag_knowledge: Gemini embeddings. Changing model/dimensions needs a full reindex;
# embedding models are never used as fallbacks for each other.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TOKENIZER=utf8-byte-budget-v1
CHROMA_PERSIST_DIR=./runtime/chroma
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8

# 05_ai_answers_analysis and 06_research_learning_agent
GEMINI_API_KEY=
# Requested identifier. Google routes this deprecated alias to gemini-3.6-flash; the
# policy file must list the returned model. Verify account access before use.
# https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash
LLM_MODEL=gemini-3.5-flash
# Optional comma-separated chat/agent models in the SAME project, tried in order when
# LLM_MODEL is rate limited or returns 5xx. Each must also be approved in the policy
# file (own pool, returned_models). Never other keys or accounts. Vision never falls back.
# Example: LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=60
MAX_CONTEXT_TOKENS=24000
ANSWER_MAX_OUTPUT_TOKENS=8192

# 06_research_learning_agent
AGENT_MAX_STEPS=8
# Model calls per research run (decisions + artifact + final answer). 4 leaves room
# for only two searches before the final answer; 6 allows a learning artifact too.
AGENT_MAX_MODEL_CALLS=4
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_TOKENS=8192
