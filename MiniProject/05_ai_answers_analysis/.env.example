# Full runtime: select this file with yk-full --env-file 05_ai_answers_analysis/.env COMMAND.
# Requires 02's full launcher; use the 02_api_backend/full locked environment.
# Process environment > this selected file > launcher defaults; no module dotenv merging.
# Server-side credentials only. No real key is required for offline tests.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60
MAX_CONTEXT_TOKENS=24000
ANSWER_MAX_OUTPUT_TOKENS=1200
ENABLE_STREAMING=false
RETRIEVAL_TOP_K=8
ANSWER_READ_PAGE_SIZE=100
ANSWER_MAX_CHUNKS=5000
ANSWER_MAX_MODEL_CALLS=64
ANSWER_MAX_HISTORY_MESSAGES=12
ANSWER_MAX_HISTORY_BYTES=4000

# Common runtime AND maintenance config. Do not change an existing pair's fingerprint.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
CHROMA_PERSIST_DIR=runtime/backend-full-live/chroma

# Use an isolated live DB, never an existing fixture/demo DB.
DATABASE_URL=sqlite:///./runtime/backend-full-live/app.db
ADAPTER_MODE=custom
ADAPTER_FACTORY=youtube_answers.team:create_adapters
BACKEND_INTEGRATION_PROFILE=live
BACKEND_FULL_PREFLIGHT=true
APP_ENV=development
# Authentication remains enabled. Supply your Google web client ID locally.
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
AUTH_TRUSTED_ORIGINS=["http://localhost:3000"]
# HTTP localhost development only; production requires HTTPS and secure cookies.
SESSION_COOKIE_SECURE=false
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
TRANSCRIPT_LANGUAGES=th,en
INGEST_TIMEOUT_SECONDS=30
METADATA_TIMEOUT_SECONDS=5
METADATA_PROVIDER=auto
YOUTUBE_API_KEY=
ENABLE_TRANSCRIPTION_FALLBACK=false
